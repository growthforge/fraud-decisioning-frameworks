{
  "name": "fraud-decisioning-frameworks",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Fraud Decisioning Frameworks \u2014 card and payment risk, the rule lifecycle. A candidate-built analytical work product.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:pages": "vite build --base=/fraud-decisioning-frameworks/ --outDir docs --emptyOutDir",
    "verify": "node --experimental-strip-types scripts/verify.ts",
    "sim": "node --experimental-strip-types scripts/sim-check.ts",
    "contamination": "node --experimental-strip-types scripts/contamination.ts",
    "export-domain": "node --experimental-strip-types scripts/export-domain.ts"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
